{
  "name": "1968 Clothing — Human Support Escalation Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-escalation",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "1968-support-escalation"
    },
    {
      "parameters": {
        "functionCode": "const body = $node[\"Webhook Trigger\"].json.body;\nif (body.event_type !== \"SUPPORT_HUMAN_REQUESTED\") {\n  return [];\n}\n\nreturn [{\n  json: {\n    conversation_id: body.payload.conversation_id,\n    customer_id: body.payload.customer_id,\n    alert_title: \"🚨 Immediate Staff Attention Required\",\n    alert_message: `Customer ${body.payload.customer_id} has requested human staff assistance on ticket ${body.payload.conversation_id}.`\n  }\n}];"
      },
      "name": "Format Alert",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/admin/support",
        "options": {}
      },
      "name": "In-App Notification Sink",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [540, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "In-App Notification Sink",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
